# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE files
.idea/
vscode/
*.swp
*.swo

# Output files
logs/
reports/

# SQLite databases
*.db
options.db
trades.db
# SQLite WAL-mode sidecars (regenerated at runtime, never source-controlled)
*.db-wal
*.db-shm
*.db-journal

# Node.js
node_modules/

# Agent / tool caches
.qwen/
_tmp/

# Connection config (may contain secrets)
connection.json
connection_real.json
# WARNING: connection.json has portfolio_env=REAL by default - change to SIMULATE for safety

# But allow Docker config (no secrets)
!connection_docker.json

# GitHub Actions - workflow files SHOULD be committed
# Note: connection.json.example and connection_docker.json should be committed
# connection.json and connection_real.json should NOT be committed
plans/

# Environment variables
.env
.env.local

# Backups and temporary files
*.bak
*.tmp
*.log
*.txt
response.txt
nul
test_otm.py
test_score.py
server_log.txt

# ── Consolidation hygiene (2026-08-02) ──────────────────────────────
# Vendored reference material and order-capable SDK examples are NOT part of
# the daily wheel app. Official docs live at openwpt.moomoo.com / openapi.moomoo.com.
opend-skills/
moomoo-API-Doc-en-Python.md

# Stale design artifacts (superseded by the live dashboard)
_design/

# Docker packaging removed; app is Windows/loopback single-process only
Dockerfile
docker-compose.yml
connection_docker.json
.dockerignore
docker/

# Python test/lint caches (regenerated)
.pytest_cache/
.ruff_cache/

# Local secrets dir must contain only its own .gitignore, never credentials
secrets/*
!secrets/.gitignore

# Planning/working notes — never ship (repo rules)
PLAN.md
REPO-AUDIT-PUNCHLIST.md
REPO-REVIEW-PLAN.md
research.md

# Local agent-harness state — never ship (F-O4/F-O5)
.claude/
.pi/

# Playwright artifacts
test-results/
playwright-report/
