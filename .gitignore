# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE files
.idea/
vscode/
*.swp
*.swo

# Output files
logs/
reports/

# SQLite databases
*.db
options.db
trades.db

# Agent / tool caches
.qwen/

# Connection config (may contain secrets)
connection.json
connection_real.json
# WARNING: connection.json has portfolio_env=REAL by default - change to SIMULATE for safety

# But allow Docker config (no secrets)
!connection_docker.json

# GitHub Actions - workflow files SHOULD be committed
# Note: connection.json.example and connection_docker.json should be committed
# connection.json and connection_real.json should NOT be committed

# Environment variables
.env
.env.local

# Backups and temporary files
*.bak
*.tmp
*.log
*.txt
response.txt
nul
test_otm.py
test_score.py
server_log.txt
