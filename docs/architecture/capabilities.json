{
  "version": 1,
  "boundaries": [
    {
      "from": "core",
      "to": "api",
      "reason": "core is the pure decision layer; the api layer composes it, never the reverse"
    },
    {
      "from": "core",
      "to": "db",
      "reason": "core stays database-free; persistence is injected by the api composition layer"
    },
    {
      "from": "db",
      "to": "api",
      "reason": "repositories do not depend on HTTP or app orchestration"
    },
    {
      "from": "api.services",
      "to": "api",
      "reason": "services receive collaborators from the app factory instead of resolving the composition root"
    },
    {
      "from": "api.services",
      "to": "api.routes",
      "reason": "routes depend on services, never the reverse"
    }
  ],
  "budgets": {
    "module_loc": 900,
    "function_loc": 150,
    "module_baseline": {
      "api/services/iv_earnings_service.py": 1299,
