# Optional application settings
SECRET_KEY=replace-with-a-random-local-secret
SANITIZE_ERRORS=true

# OpenD connection overrides
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_PORTFOLIO_ENV=SIMULATE
MOOMOO_ACCOUNT_ID=
MOOMOO_SECURITY_FIRM=FUTUSECURITIES
CONNECTION_CONFIG=connection.json
PORT=8000

# Optional static watchlist merged into the broker watchlist group
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,AMD,NFLX,UBER,SOFI,PLTR,BABA,DIS,BA,JPM,V,MA,KO,PEP,WMT,COST,HD,INTC,F
