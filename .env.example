# Moomoo OpenD Credentials
MOOMOO_LOGIN=your-email@example.com
MOOMOO_PASSWORD=your-moomoo-password

# Trading Password (required for live trading)
MOOMOO_TRADING_PASSWORD=your-trading-password

# Optional: Language (en or ch)
MOOMOO_LANG=en

# Optional: OpenD log level (no, debug, info)
MOOMOO_LOG_LEVEL=info

# Optional: Port overrides
# OPEND_PORT=11111
# PORT=8000

# Optional static watchlist used by the app fallback / hybrid mode
# Catalyst Watch can also widen its scan universe with Ape Wisdom, but that
# social expansion is configured in connection.json under catalyst_flow.apewisdom.
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,AMD,NFLX,UBER,SOFI,PLTR,BABA,DIS,BA,JPM,V,MA,KO,PEP,WMT,COST,HD,INTC,F

# FRED API Key for macro economic regime detection (free, get at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Optional: enrichment adapter (disabled by default)
# OPENBB_ENABLED=false

# Alpha Vantage API Key for bulk earnings calendar data (free, get at https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ----------------------------------------------------------------------------
# LLM Configuration (for AI trade advisor)
# Set LLM_ENABLED=true and provide an API key to use the AI advisor panel.
# The OpenAI client works with: OpenAI, Anthropic (compatible mode),
# OpenRouter, Ollama, and any OpenAI-compatible API.
# ----------------------------------------------------------------------------
LLM_ENABLED=false
LLM_PROVIDER=openai              # openai | anthropic | openrouter | ollama | custom
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o                 # gpt-4o | claude-sonnet-4-20250514 | etc.
# LLM_BASE_URL=https://api.openai.com/v1   # Optional: override for OpenRouter or self-hosted
# LLM_TEMPERATURE=0.3                       # Optional: 0.0 = deterministic, 1.0 = creative
# LLM_MAX_TOKENS=2000                       # Optional: max tokens in response
