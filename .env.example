# Moomoo OpenD Credentials
MOOMOO_LOGIN=your-email@example.com
MOOMOO_PASSWORD=your-moomoo-password

# Optional: Language (en or ch)
MOOMOO_LANG=en

# Optional: OpenD log level (no, debug, info)
MOOMOO_LOG_LEVEL=info

# Optional: Port overrides
# OPEND_PORT=11111
# PORT=8000

# Optional static watchlist used by the app fallback / hybrid mode.
# The primary watchlist source is the named Moomoo group
# (MOOMOO_WATCHLIST_GROUP, default "My Watchlist"); this list is merged
# into the scan union as the "config" source.
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,AMD,NFLX,UBER,SOFI,PLTR,BABA,DIS,BA,JPM,V,MA,KO,PEP,WMT,COST,HD,INTC,F
